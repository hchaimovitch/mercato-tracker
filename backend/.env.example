# Copie ce fichier en .env et renseigne tes clés.

# Port HTTP du serveur (optionnel, défaut 4000)
PORT=4000

# --- API-Football (transferts officiels confirmés) ---
# Compte gratuit sur https://www.api-football.com (ou via RapidAPI) — 100 req/jour.
API_FOOTBALL_KEY=
# Mets à "true" si tu utilises la clé RapidAPI plutôt que api-sports.io en direct.
API_FOOTBALL_VIA_RAPIDAPI=false
# Marge de sécurité sous le quota gratuit de 100 req/jour.
API_FOOTBALL_DAILY_CAP=90
# Nombre de clubs synchronisés par passage (répartit la charge sur la journée).
API_FOOTBALL_BATCH_SIZE=20
# Pause entre deux appels /transfers (ms) — le plan gratuit limite aussi à 10 req/min
# (pas seulement 100/jour) ; sans cette pause, ce plafond est dépassé.
API_FOOTBALL_MIN_INTERVAL_MS=6500

# --- SportMonks (rumeurs, optionnel) ---
# Nécessite un plan payant + l'add-on "Transfer Rumours" (prix non public, voir
# l'audit initial) — laisse vide pour désactiver proprement les rumeurs et ne
# suivre que les transferts officiels.
SPORTMONKS_KEY=
SPORTMONKS_DAILY_CAP=48

# Planification de la synchronisation (format cron). Toutes les 4h par défaut.
SYNC_CRON=0 */4 * * *
# Passe à "false" pour ne pas lancer un premier sync immédiatement au démarrage.
SYNC_ON_STARTUP=true

# --- Montants de transfert (dataset Transfermarkt republié, voir README) ---
# Planification de la complétion des montants. Une fois par semaine par défaut
# (calé sur le rythme de rafraîchissement de la source, inutile plus souvent).
TRANSFERMARKT_DATASET_CRON=0 3 * * 1

# Chemin du fichier SQLite local (dev uniquement — ignoré si TURSO_DATABASE_URL est renseigné)
DATABASE_PATH=

# --- Turso (base de données persistante, gratuite, pour la production) ---
# Laisse les deux vides en développement local : le backend utilise alors un
# fichier SQLite local automatiquement (aucun compte requis).
# Renseigne-les pour déployer (ex: sur Render) avec une base qui survit aux
# redémarrages/redeploiements. Récupère ces valeurs sur https://turso.tech
# après `turso db create mercato` puis `turso db show mercato --url` et
# `turso db tokens create mercato`.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=
